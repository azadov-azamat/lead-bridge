# ============================================================
# Node muhiti
# ============================================================
NODE_ENV=development

# ============================================================
# HTTP server
# ============================================================
# Render avtomatik PORT env beradi (cloud)
PORT=8080

# Production'da Render external URL (HTTPS). Webhook shu URL ostiga register qilinadi.
# Masalan: https://lead-bridge.onrender.com
BACK_HOST_NAME=https://lead-bridge.onrender.com

# Telegram webhook path (production rejimida ishlatiladi)
WEBHOOK_PATH=/api/webhook_telegram

# ============================================================
# Cluster (multi-worker)
# ============================================================
# Bo'sh qoldirilsa CPU count ishlatiladi.
# Render free tier (single instance) uchun: 1
WEB_CONCURRENCY=1

# Bot va poller faqat shu ID dagi worker'da ishga tushadi.
# Boshqa workerlar faqat HTTP webhook callback xizmat qiladi.
BOT_PRIMARY_WORKER=1

# ============================================================
# Memory monitor (har worker o'z heap'ini kuzatadi)
# ============================================================
# Warning threshold (MB) — force GC chaqiriladi (--expose-gc bilan)
MEMORY_MAX_HEAP_MB=400
# Critical threshold (MB) — graceful shutdown trigger
MEMORY_CRITICAL_HEAP_MB=450
# Tekshirish intervali (ms)
MEMORY_CHECK_INTERVAL_MS=120000

# ============================================================
# Telegram
# ============================================================
TELEGRAM_BOT_TOKEN=

# ============================================================
# Google OAuth
# ============================================================
# Sheet'larning egasi bo'ladigan Google account
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OWNER_EMAIL=

# ============================================================
# Postgres (Render external URL)
# ============================================================
DATABASE_URL=
# SSL standart Render uchun yoqilgan; lokal Postgres ishlatsangiz "false" qiling
DATABASE_SSL=true
# SQL loglarini console'ga chiqarish
DATABASE_LOGGING=false

# ============================================================
# Redis (Render Key Value external URL)
# ============================================================
REDIS_URL=

# ============================================================
# Poller
# ============================================================
# Poller intervali (ms, default: 60000 = 1 daqiqa)
POLL_INTERVAL_MS=60000
# Distributed lock TTL — bitta tick maksimal davomiyligi (ms)
POLLER_LOCK_TTL_MS=300000

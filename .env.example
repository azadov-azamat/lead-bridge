# Node muhiti: development | production | test
NODE_ENV=development

# HTTP server porti (Render avtomatik PORT env beradi)
PORT=8080

# Production'da Render external URL (HTTPS). Webhook shu URL ostiga register qilinadi.
# Masalan: https://lead-bridge.onrender.com
BACK_HOST_NAME=https://lead-bridge.onrender.com

# Telegram webhook path (production rejimida ishlatiladi)
WEBHOOK_PATH=/api/webhook_telegram

# Telegram bot tokeni (BotFather'dan olinadi)
TELEGRAM_BOT_TOKEN=

# Google auth usuli:
# - oauth           -> bitta default Google account refresh token bilan ishlaydi
# - service_account -> eski usul; faqat quota/ruxsat to'g'ri bo'lsa ishlaydi
GOOGLE_AUTH_MODE=oauth

# Tavsiya etilgan usul: default OAuth user
# GOOGLE_OWNER_EMAIL - sheet'larning egasi bo'ladigan Google account
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OWNER_EMAIL=

# Eski fallback: Google Service Account JSON fayl yo'li
GOOGLE_CREDENTIALS_PATH=./credentials/service-account.json

# Postgres (Render external URL)
DATABASE_URL=
# SSL standart Render uchun yoqilgan; lokal Postgres ishlatsangiz "false" qiling
DATABASE_SSL=true
# SQL loglarini console'ga chiqarish
DATABASE_LOGGING=false

# Redis (Render Key Value external URL)
REDIS_URL=

# Poller intervali (millisekundda, default: 60000 = 1 daqiqa)
POLL_INTERVAL_MS=60000
# Distributed lock TTL — bitta tick maksimal davomiyligi (ms)
POLLER_LOCK_TTL_MS=300000

# Admin Telegram ID (xatolik xabarlari shu userga keladi, ixtiyoriy)
ADMIN_TELEGRAM_ID=

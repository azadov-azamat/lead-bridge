  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "ioredis": "^5.4.1",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "telegraf": "^4.16.3",
    "umzug": "^3.8.2"
  },
  "engines": {
    "node": ">=18"
  }
}

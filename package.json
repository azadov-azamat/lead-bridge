{
  "name": "lead-bridge",
  "version": "2.1.0",
  "description": "Self-serve Telegram bot: Facebook Lead Ads → Google Sheet → Telegram guruh",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
